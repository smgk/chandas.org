    {
      "id": "structural:kanda-kannada",
      "name": "kanda (Kannada)",
      "aliases": [
        "kanda",
        "kandapadya",
        "kanda padya",
        "ಕಂದ",
        "ಕಂದಪದ್ಯ",
        "ಕಂದ ಪದ್ಯ"
      ],
      "kind": "matra",
      "signatureLines": [
        "12 | 20 | 12 | 20 mātrās",
        "groups: 444 | 44444 | 444 | 44444",
        "gaṇas 6 & 14: LGL or LLLL; 8 & 16 end G"
      ],
      "ruleCompleteness": "provisional-rhythm",
      "uncheckedRules": ["prāsa"],
      "sourceRef": "kandaSource",
      "linePolicy": { "type": "fixed", "count": 4 },
      "padaGroups": [[4, 4, 4], [4, 4, 4, 4, 4], [4, 4, 4], [4, 4, 4, 4, 4]],
      "groupRules": [
        {
          "globalGroups": [1, 3, 5, 7, 9, 11, 13, 15],
          "forbiddenPatterns": ["LGL"],
          "violationReason": "forbidden-jagana"
        },
        {
          "globalGroups": [6, 14],
          "allowedPatterns": ["LGL", "LLLL"],
          "violationReason": "required-jagana-or-all-laghu"
        },
        {
          "globalGroups": [8, 16],
          "allowedPatterns": ["LLG", "GG"],
          "violationReason": "required-final-guru"
        }
      ],
      "boundaryRules": [
        {
          "globalGroups": [6, 14],
          "whenPatterns": ["LLLL"],
          "afterSyllable": 1,
          "violationReason": "required-yati"
        }
      ],
      "notes": "Implements the rhythmic and yati rules in the cited rule packet. Prāsa is not yet checked, and the entry remains provisional until the golden corpus is approved."
    },
    {
      "id": "structural:mandanila-ragale",
      "name": "mandānila ragaḷe",
      "aliases": [
        "mandanila ragale",
        "mandaanila ragale",
        "mandanila ragaḷe",
        "ಮಂದಾನಿಲ ರಗಳೆ",
        "ಮಂದಾನಿಲರಗಳೆ"
      ],
      "kind": "matra",
      "signatureLines": [
        "unbounded lines; 4 gaṇas per line",
        "4+4+4+4 = 16 mātrās; 3+5+3+5 is also accepted",
        "a gaṇa may not begin LG; adjacent lines use antya-prāsa"
      ],
      "ruleCompleteness": "provisional-rhythm",
      "uncheckedRules": ["śithila-dvitva", "historical variants"],
      "sourceRef": "ragaleSource",
      "linePolicy": { "type": "repeating", "unit": "line", "min": 1, "previewCount": 1 },
      "padaGroups": [[4, 4, 4, 4]],
      "padaGroupOptions": [
        [[4, 4, 4, 4], [3, 5, 3, 5]]
      ],
      "groupRules": [
        {
          "everyGroup": true,
          "forbiddenPrefixes": ["LG"],
          "violationReason": "forbidden-lagam-opening"
        }
      ],
      "lineRelations": [
        {
          "type": "pairwise-antya-prasa",
          "pairSize": 2,
          "violationReason": "antya-prasa-mismatch"
        }
      ],
      "notes": "Checks repeatable line rhythm, the documented 3+5 alternative, lagam restriction, and pairwise end-rhyme. The entry remains provisional pending expert review."
    },
