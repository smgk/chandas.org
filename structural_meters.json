    {
      "id": "structural:anushtubh-pathya",
      "name": "anuṣṭubh (pathyā)",
      "aliases": ["anuṣṭubh", "anushtubh", "anushtup", "anustubh", "anustup", "śloka", "shloka"],
      "kind": "syllable-structural",
      "signatureLines": [
        "4 pādas × 8 syllables",
        "odd pādas: positions 5–7 = LGG",
        "even pādas: positions 5–7 = LGL"
      ],
      "ruleCompleteness": "pathyā",
      "padas": [
        {
          "syllables": 8,
          "cadence": { "start": 5, "pattern": "LGG" },
          "forbidden": [{ "start": 2, "patterns": ["LLL", "LLG"] }]
        },
        {
          "syllables": 8,
          "cadence": { "start": 5, "pattern": "LGL" },
          "forbidden": [{ "start": 2, "patterns": ["LLL", "LLG", "GLG"] }]
        },
        {
          "syllables": 8,
          "cadence": { "start": 5, "pattern": "LGG" },
          "forbidden": [{ "start": 2, "patterns": ["LLL", "LLG"] }]
        },
        {
          "syllables": 8,
          "cadence": { "start": 5, "pattern": "LGL" },
          "forbidden": [{ "start": 2, "patterns": ["LLL", "LLG", "GLG"] }]
        }
      ],
      "notes": "This first rule set recognizes pathyā Anuṣṭubh. Vipulā variations are not yet accepted.",
      "source": {
        "title": "A Study on the Sanskrit Meter: Anuṣṭubh",
        "url": "https://www.kci.go.kr/kciportal/ci/sereArticleSearch/ciSereArtiView.kci?sereArticleSearchBean.artiId=ART001963953"
